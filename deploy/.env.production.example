# Keep this file as /data/cqai-logto/.env on the deployment server.
# Never commit the real production values.

# Use a URL-safe random password, or percent-encode it in DB_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_URL=postgresql://logto:replace-with-a-long-random-password@postgres:5432/logto

# Public HTTPS origins. Configure both DNS records and the reverse proxy first.
ENDPOINT=https://auth.example.com
ADMIN_ENDPOINT=https://auth-admin.example.com

# The shujubang host already uses ports 3001 and 3002. Keep Logto on dedicated
# loopback-only ports for the host reverse proxy.
LOGTO_PORT=3011
LOGTO_ADMIN_PORT=3012
TRUST_PROXY_HEADER=1

# Recommended: openssl rand -base64 32
SECRET_VAULT_KEK=

# Optional services and hardening.
REDIS_URL=
STATUS_API_KEY=
PRIVATE_KEY_ROTATION_GRACE_PERIOD=0
SSRF_ALLOWED_ADDRESSES=
